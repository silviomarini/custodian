{
  "name": "@silviomarini/custodian",
  "version": "0.1.0",
  "description": "Admin panel shell — auth, layout, and a pluggable module system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./blog": {
      "types": "./dist/modules/blog/index.d.ts",
      "default": "./dist/modules/blog/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marinisilvio/custodian.git"
  },
  "keywords": [],
  "author": "marinisilvio",
  "license": "UNLICENSED",
  "private": false,
  "dependencies": {
    "@silviomarini/auth": "^0.2.0",
    "@silviomarini/blog-engine": "^0.3.0"
  },
  "peerDependencies": {
    "@supabase/ssr": ">=0.4.0",
    "@supabase/supabase-js": ">=2.0.0",
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    },
    "@supabase/ssr": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.0.0",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "next": "^15.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
